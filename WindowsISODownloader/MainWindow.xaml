<Window x:Class="WindowsISODownloader.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Windows ISO Downloader" Icon="Assets/WindowsISODownloader.ico" Width="1300" Height="850" MinWidth="320" MinHeight="220" WindowStartupLocation="CenterScreen" Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
<Viewbox Stretch="Uniform" StretchDirection="DownOnly"><Grid Width="1200" MinHeight="730" Margin="30,24"><Grid.RowDefinitions><RowDefinition Height="120"/><RowDefinition Height="240"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid><StackPanel><TextBlock Text="Windows ISO Downloader" FontSize="42" FontWeight="Bold"/><TextBlock x:Name="SubtitleText" FontSize="21" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><ComboBox x:Name="UiLanguageCombo" Width="145" Margin="0,0,16,0" SelectionChanged="UiLanguageCombo_SelectionChanged"><ComboBoxItem Content="Türkçe" Tag="tr"/><ComboBoxItem Content="English" Tag="en"/></ComboBox><ComboBox x:Name="ThemeCombo" Width="145" SelectionChanged="ThemeCombo_SelectionChanged"><ComboBoxItem Content="Sistem" Tag="System"/><ComboBoxItem Content="Koyu" Tag="Dark"/><ComboBoxItem Content="Açık" Tag="Light"/></ComboBox></StackPanel></Grid>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Grid.Row="0" x:Name="ProductLabel" Text="Ürün" FontSize="22" VerticalAlignment="Center"/><Grid Grid.Row="0" Grid.Column="1" Margin="0,5"><ComboBox x:Name="ProductCombo" ToolTip="{Binding Text, ElementName=ProductInfoText}" SelectionChanged="ProductCombo_SelectionChanged">
                            <ComboBoxItem Content="Windows 11" IsSelected="True"/><ComboBoxItem Content="Windows 11 LTSC"/><ComboBoxItem Content="Windows 10"/><ComboBoxItem Content="Office"/><ComboBoxItem Content="Office 2019"/><ComboBoxItem Content="Office 2016"/><ComboBoxItem Content="Windows Server"/><ComboBoxItem Content="Windows Embedded POSReady 2009"/><ComboBoxItem Content="Microsoft Edge"/><ComboBoxItem Content="Microsoft PowerToys"/><ComboBoxItem Content="Visual Studio Code"/><ComboBoxItem Content="Sysinternals Suite"/><ComboBoxItem Content="Visual C++ Redistributable"/><ComboBoxItem Content="Windows Terminal"/><ComboBoxItem Content="Windows ADK"/><ComboBoxItem Content="Windows PE add-on"/><ComboBoxItem Content="SQL Server"/><ComboBoxItem Content="Visual Studio Community"/><ComboBoxItem Content="Visual Studio Build Tools"/><ComboBoxItem Content=".NET SDK"/><ComboBoxItem Content=".NET Runtime"/><ComboBoxItem Content=".NET Desktop Runtime"/><ComboBoxItem Content=".NET ASP.NET Core Runtime"/>
                        </ComboBox></Grid><TextBlock Grid.Row="1" x:Name="VersionLabel" Text="Sürüm" FontSize="22" VerticalAlignment="Center"/><Grid Grid.Row="1" Grid.Column="1" Margin="0,5"><ComboBox x:Name="VersionCombo"/></Grid><TextBlock Grid.Row="2" x:Name="ArchitectureLabel" Text="Mimari" FontSize="22" VerticalAlignment="Center"/><Grid Grid.Row="2" Grid.Column="1" Margin="0,5"><ComboBox x:Name="ArchitectureCombo" SelectionChanged="ArchitectureCombo_SelectionChanged"/></Grid><TextBlock Grid.Row="3" x:Name="FileLanguageLabel" Text="Dosya dili" FontSize="22" VerticalAlignment="Center"/><Grid Grid.Row="3" Grid.Column="1" Margin="0,5"><ComboBox x:Name="LanguageCombo"/></Grid></Grid>
<StackPanel Grid.Row="2" Margin="0,16,0,0"><TextBlock x:Name="StatusText" TextWrapping="Wrap" Text="İndirmeye hazır" FontSize="20" Foreground="{DynamicResource MutedBrush}"/><ProgressBar x:Name="DownloadProgress" Height="22" Margin="0,12,0,0" Maximum="100" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource Panel2Brush}"/><ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0"><TextBlock x:Name="DetailsText" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/></ScrollViewer></StackPanel>
<StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,18,0,0"><Button x:Name="DownloadButton" Width="350" Height="58" Background="{DynamicResource PrimaryButtonBrush}" Foreground="{DynamicResource PrimaryButtonTextBrush}" BorderBrush="{DynamicResource PrimaryButtonBorderBrush}" Click="DownloadButton_Click"><TextBlock x:Name="DownloadButtonText" Text="Dosyayı indir" Foreground="{DynamicResource PrimaryButtonTextBrush}" FontSize="22" FontWeight="SemiBold"/></Button><Button x:Name="CancelButton" Content="İptal" Width="220" Height="58" FontSize="22" Margin="16,0,0,0" Click="CancelButton_Click" IsEnabled="False"/><Button x:Name="OfficeOptionsButton" Click="OfficeOptionsButton_Click" Content="Office seçenekleri" Visibility="Collapsed" Margin="16,0,0,0"/></StackPanel>
<StackPanel Grid.Row="4"><Border x:Name="ResultPanel" Visibility="Collapsed" Margin="0,18,0,0" Padding="14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"><StackPanel><StackPanel Orientation="Horizontal"><Button x:Name="FolderButton" Content="Klasörü aç" Click="FolderButton_Click"/><Button x:Name="MountButton" Content="ISO’yu bağla" Click="MountButton_Click" Margin="10,0"/><Button x:Name="SignatureButton" Content="İmza bilgisi" Click="SignatureButton_Click"/><Button x:Name="InstallOfficeButton" Click="InstallOfficeButton_Click" Content="Office kur" Visibility="Collapsed" Margin="10,0,0,0"/><Button x:Name="HashCopyButton" Content="SHA-256 kopyala" Click="HashCopyButton_Click" Margin="10,0"/></StackPanel><TextBlock x:Name="HashHint" FontSize="13" Margin="0,10,0,4"/><TextBox x:Name="HashValue" IsReadOnly="True" FontFamily="Consolas" FontSize="15" Background="{DynamicResource Panel2Brush}" Foreground="{DynamicResource TextBrush}"/><TextBlock x:Name="ExpectedHashLabel" FontSize="13" Margin="0,10,0,4"/><DockPanel><Button x:Name="HashCompareButton" DockPanel.Dock="Right" Content="Karşılaştır" Click="HashCompareButton_Click"/><TextBox x:Name="ExpectedHash" FontSize="15" Background="{DynamicResource Panel2Brush}" Foreground="{DynamicResource TextBrush}"/></DockPanel></StackPanel></Border><Border Grid.Row="4" Margin="0,28,0,0" CornerRadius="12" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Padding="20,12" Background="{DynamicResource BannerBrush}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="430"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><Grid Width="400" Height="75" HorizontalAlignment="Left"><Image x:Name="SiteLogo" Source="Assets/SiteLogo-light.png" Stretch="Uniform"/><Rectangle x:Name="LogoLightLetters" Fill="#F3F7FF" Visibility="Collapsed"><Rectangle.OpacityMask><ImageBrush ImageSource="Assets/SiteLogo-light.png" Stretch="Uniform"/></Rectangle.OpacityMask><Rectangle.Clip><RectangleGeometry Rect="0,0,300,75"/></Rectangle.Clip></Rectangle></Grid><Border Grid.Column="1" Background="{DynamicResource BorderBrush}"/><TextBlock Grid.Column="2" x:Name="PromotionText" Text="Windows rehberleri ve ücretsiz araçlar" Foreground="{DynamicResource MutedBrush}" FontSize="18" Margin="24,0" VerticalAlignment="Center" TextWrapping="Wrap"/><Button Grid.Column="3" x:Name="VisitSiteButton" Content="↗  Siteyi ziyaret et" FontSize="20" Foreground="{DynamicResource Accent2Brush}" BorderBrush="{DynamicResource AccentBrush}" Background="Transparent" Click="VisitSiteButton_Click"/></Grid></Border></StackPanel>
<DockPanel Grid.Row="5" Margin="0,18,0,0"><StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Button x:Name="UpdateButton" Click="UpdateButton_Click" Content="Güncellemeleri kontrol et"/><TextBlock x:Name="UpdateStatus" Margin="12,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="650"/></StackPanel><Button x:Name="AboutButton" Content="Hakkında" DockPanel.Dock="Right" Click="AboutButton_Click" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Accent2Brush}" Padding="0" FontSize="17"/><TextBlock x:Name="FooterText" Visibility="Collapsed" Text="" FontSize="17" Foreground="{DynamicResource MutedBrush}"/></DockPanel>
<StackPanel Visibility="Collapsed"><TextBlock x:Name="ThemeLabel"/><TextBlock x:Name="InterfaceLanguageLabel"/><TextBlock x:Name="SelectionHeading"/><TextBlock x:Name="DownloadHeading"/><TextBlock x:Name="ProductInfoText"/></StackPanel>
</Grid></Viewbox></Window>