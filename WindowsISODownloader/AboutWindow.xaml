<Window x:Class="WindowsISODownloader.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hakkında — Windows ISO Downloader" Icon="Assets/WindowsISODownloader.ico"
        Width="510" Height="510" MinWidth="470" MinHeight="420" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
  <Border Margin="24" Padding="24" CornerRadius="12" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
        <Image Source="Assets/WindowsISODownloader.png" Width="52" Height="52" Margin="0,0,14,0"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Windows ISO Downloader" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock x:Name="AboutVersionText" Text="" Foreground="{DynamicResource MutedBrush}"/>
        </StackPanel>
      </StackPanel>
      <TextBlock x:Name="DeveloperText" Text="Geliştirici: Bünyamin Kaya" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/>
      <TextBlock Foreground="{DynamicResource TextBrush}"><Run x:Name="EmailLabel" Text="E-posta: "/><Hyperlink NavigateUri="mailto:bunyaminkaya@gmail.com" RequestNavigate="Link_RequestNavigate">bunyaminkaya@gmail.com</Hyperlink></TextBlock>
      <TextBlock Margin="0,10,0,0"><Run Text="Web: "/><Hyperlink NavigateUri="https://bunyaminkaya.com/" RequestNavigate="Link_RequestNavigate">bunyaminkaya.com</Hyperlink></TextBlock>
      <TextBlock Margin="0,10,0,0"><Run Text="YouTube: "/><Hyperlink NavigateUri="https://www.youtube.com/@benbunyaminkaya" RequestNavigate="Link_RequestNavigate">@benbunyaminkaya</Hyperlink></TextBlock>
      <TextBlock Margin="0,10,0,0"><Run Text="Reddit: "/><Hyperlink NavigateUri="https://www.reddit.com/user/bunyaminkaya/" RequestNavigate="Link_RequestNavigate">u/bunyaminkaya</Hyperlink></TextBlock>
      <TextBlock x:Name="AboutNoticeText" Margin="0,22,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Text="Bu uygulama Microsoft ile bağlantılı değildir. LTSC değerlendirme dosyaları süreli kullanıma yöneliktir. Office kurulumu için geçerli lisans gerekir."/>
      </StackPanel>
      </ScrollViewer>
      <Button x:Name="CloseButton" Grid.Row="1" Content="Kapat" HorizontalAlignment="Right" Width="90" Margin="0,16,0,0" Click="CloseButton_Click"/>
    </Grid>
  </Border>
</Window>
